ngOnInit() {
  this.startLogging();
  this.runBackgroundTask();
}// AVOID
ngOnInit() {
  this.logger.setMode('info');
  this.logger.monitorErrors();
  // ...and all the rest of the code that would be unrolled from these methods.
}
```

