TITLE: Integrating Request Status Feature into a SignalStore (TypeScript)
DESCRIPTION: This example demonstrates how to compose the `withRequestStatus` feature and its associated updaters within an `ngrx/signals` `signalStore` named `BooksStore`. It uses `patchState` with the `setPending` and `setFulfilled` updaters to manage the request status during an asynchronous `loadAll` operation, alongside `withEntities` for entity management. This shows a practical application of custom features for managing complex store states.
SOURCE: https://github.com/ngrx/platform/blob/main/projects/www/src/app/pages/guide/signals/signal-store/custom-store-features.md#_snippet_2

LANGUAGE: TypeScript
CODE:

```
import { inject } from '@angular/core';
import { patchState, signalStore, withMethods } from '@ngrx/signals';
import { setAllEntities, withEntities } from '@ngrx/signals/entities';
import {
  setFulfilled,
  setPending,
  withRequestStatus,
} from './request-status.feature';
import { Book } from './book.model';
import { BooksService } from './books.service';

export const BooksStore = signalStore(
  withEntities<Book>(),
  withRequestStatus(),
  withMethods((store, booksService = inject(BooksService)) => ({
    async loadAll() {
      patchState(store, setPending());

      const books = await booksService.getAll();
      patchState(store, setAllEntities(books), setFulfilled());
    },
  }))
);
```

