TITLE: Implementing a Counter Component with NgRx SignalState in Angular
DESCRIPTION: This comprehensive example demonstrates using SignalState within an Angular component to manage a simple counter. It shows initializing state, displaying its value in the template, and updating it via `patchState` in component methods, illustrating a practical application.
SOURCE: https://github.com/ngrx/platform/blob/main/projects/ngrx.io/content/guide/signals/signal-state.md#_snippet_7

LANGUAGE: TypeScript
CODE:

```
import { ChangeDetectionStrategy, Component } from '@angular/core';
import { signalState, patchState } from '@ngrx/signals';

@Component({
  selector: 'ngrx-counter',
  template: `
    &lt;p&gt;Count: {{ state.count() }}&lt;/p&gt;

    &lt;button (click)="increment()"&gt;Increment&lt;/button&gt;
    &lt;button (click)="decrement()"&gt;Decrement&lt;/button&gt;
    &lt;button (click)="reset()"&gt;Reset&lt;/button&gt;
  `,
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class Counter {
  readonly state = signalState({ count: 0 });

  increment(): void {
    patchState(this.state, (state) => ({ count: state.count + 1 }));
  }

  decrement(): void {
    patchState(this.state, (state) => ({ count: state.count - 1 }));
  }

  reset(): void {
    patchState(this.state, { count: 0 });
  }
}
```

