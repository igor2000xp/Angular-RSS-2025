TITLE: Handling API Calls with RxMethod and tapResponse in NgRx
DESCRIPTION: This snippet illustrates a practical application of `rxMethod` for fetching data from an API. It defines `loadBookById` to fetch a book based on a `selectedBookId` signal, using `filter` to prevent unnecessary calls and `concatMap` to handle asynchronous API requests. It integrates `tapResponse` from `@ngrx/operators` for robust error handling and state updates, demonstrating a common pattern for reactive data loading.
SOURCE: https://github.com/ngrx/platform/blob/main/projects/ngrx.io/content/guide/signals/rxjs-integration.md#_snippet_4

LANGUAGE: TypeScript
CODE:

```
import { Component, inject, signal } from '@angular/core';
import { concatMap, filter, pipe } from 'rxjs';
import { rxMethod } from '@ngrx/signals/rxjs-interop';
import { tapResponse } from '@ngrx/operators';
import { BooksService } from './books-service';
import { Book } from './book';

@Component({ /* ... */ })
export class BookList {
  readonly #booksService = inject(BooksService);

  readonly bookMap = signal<Record<string, Book>>({});
  readonly selectedBookId = signal<string | null>(null);

  readonly loadBookById = rxMethod<string | null>(
    pipe(
      filter((id) => !!id && !this.bookMap()[id]),
      concatMap((id) => {
        return this.#booksService.getById(id).pipe(
          tapResponse({
            next: (book) => this.addBook(book),
            error: console.error,
          })
        );
      })
    )
  );

  constructor() {
    // 👇 Load book by id whenever the `selectedBookId` value changes.
    this.loadBookById(this.selectedBookId);
  }

  addBook(book: Book): void {
    this.bookMap.update((bookMap) => ({ ...bookMap, [book.id]: book }));
  }
}
```

