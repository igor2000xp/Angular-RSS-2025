TITLE: Implementing Book Store with NgRx SignalState in TypeScript
DESCRIPTION: This snippet defines a `BooksStore` service using NgRx SignalState to manage book data and loading state. It utilizes `signalState` for reactive state, `rxMethod` for handling side effects (fetching books via `BooksService`), and `patchState` to update the state based on API responses, including error handling and finalization.
SOURCE: https://github.com/ngrx/platform/blob/main/projects/www/src/app/pages/guide/signals/signal-state.md#_snippet_8

LANGUAGE: TypeScript
CODE:

```
import { inject, Injectable } from '@angular/core';
import { exhaustMap, pipe, tap } from 'rxjs';
import { signalState, patchState } from '@ngrx/signals';
import { rxMethod } from '@ngrx/signals/rxjs-interop';
import { tapResponse } from '@ngrx/operators';
import { BooksService } from './books.service';
import { Book } from './book.model';

type BooksState = { books: Book[]; isLoading: boolean };

const initialState: BooksState = {
  books: [],
  isLoading: false,
};

@Injectable()
export class BooksStore {
  readonly #booksService = inject(BooksService);
  readonly #state = signalState(initialState);

  readonly books = this.#state.books;
  readonly isLoading = this.#state.isLoading;

  readonly loadBooks = rxMethod<void>(
    pipe(
      tap(() => patchState(this.#state, { isLoading: true })),
      exhaustMap(() => {
        return this.#booksService.getAll().pipe(
          tapResponse({
            next: (books) => patchState(this.#state, { books }),
            error: console.error,
            finalize: () =>
              patchState(this.#state, { isLoading: false }),
          })
        );
      })
    )
  );
}
```

