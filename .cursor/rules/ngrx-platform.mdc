TITLE: Defining Reactive Method for Loading Books by Query in NgRx SignalStore (TypeScript)
DESCRIPTION: This snippet demonstrates how to define a reactive method `loadByQuery` within an NgRx SignalStore using `rxMethod`. It utilizes RxJS operators like `debounceTime` and `distinctUntilChanged` for input throttling, `tap` to update loading state, and `switchMap` to call `BooksService.getByQuery`. The `tapResponse` operator handles success and error responses, patching the store state with fetched books or managing errors.
SOURCE: https://github.com/ngrx/platform/blob/main/projects/www/src/app/pages/guide/signals/signal-store/index.md#_snippet_9

LANGUAGE: TypeScript
CODE:

```
import { computed, inject } from '@angular/core';
import {
  debounceTime,
  distinctUntilChanged,
  pipe,
  switchMap,
  tap,
} from 'rxjs';
import { patchState, signalStore /* ... */ } from '@ngrx/signals';
import { rxMethod } from '@ngrx/signals/rxjs-interop';
import { tapResponse } from '@ngrx/operators';
import { Book } from './book.model';
import { BooksService }s from './books.service';

type BooksState = {
  /* ... */
};

const initialState: BooksState = {
  /* ... */
};

export const BooksStore = signalStore(
  withState(initialState),
  withComputed(/* ... */),
  withMethods((store, booksService = inject(BooksService)) => ({
    /* ... */
    // 👇 Defining a method to load books by query.
    loadByQuery: rxMethod<string>(
      pipe(
        debounceTime(300),
        distinctUntilChanged(),
        tap(() => patchState(store, { isLoading: true })),
        switchMap((query) => {
          return booksService.getByQuery(query).pipe(
            tapResponse({
              next: (books) =>
                patchState(store, { books, isLoading: false }),
              error: (err) => {
                patchState(store, { isLoading: false });
                console.error(err);
              },
            })
          );
        })
      )
    ),
  }))
);
```

