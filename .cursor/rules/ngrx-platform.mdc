TITLE: Handling State Changes with Reducers in NgRx SignalStore
DESCRIPTION: This snippet demonstrates how to use `withReducer` and `on` functions within an NgRx `signalStore` to manage state changes in response to dispatched events. It shows how to map different events (e.g., `bookSearchEvents.opened`, `booksApiEvents.loadedSuccess`) to specific reducer logic that updates the store's state.
SOURCE: https://github.com/ngrx/platform/blob/main/projects/ngrx.io/content/guide/signals/signal-store/events.md#_snippet_4

LANGUAGE: TypeScript
CODE:

```
import { signalStore, withState } from '@ngrx/signals';
import { on, withReducer } from '@ngrx/signals/events';
import { bookSearchEvents } from './book-search-events';
import { booksApiEvents } from './books-api-events';
import { Book } from './book';

type State = { query: string; books: Book[]; isLoading: boolean };

export const BookSearchStore = signalStore(
  withState<State>({ query: '', books: [], isLoading: false }),
  withReducer(
    on(bookSearchEvents.opened, () => ({ isLoading: true })),
    on(
      bookSearchEvents.queryChanged,
      ({ payload: query }) => ({ query, isLoading: true })
    ),
    on(
      booksApiEvents.loadedSuccess,
      ({ payload: books }) => ({ books, isLoading: false })
    ),
    on(booksApiEvents.loadedFailure, () => ({ isLoading: false }))
  )
);
```

