TITLE: Preventing Feature Module Import - Angular - TypeScript
DESCRIPTION: Implements a pattern within an Angular module to prevent it from being imported into feature modules. It enforces that the module can only be imported once, typically in the root AppModule, often used with a static forRoot method for configuration.
SOURCE: https://github.com/avivharuzi/angular-best-practices/blob/main/README.md#_snippet_26

LANGUAGE: TypeScript
CODE:

```
import {
  ModuleWithProviders,
  NgModule,
  Optional,
  SkipSelf,
} from '@angular/core';

import {
  AUTH_CONFIG_TOKEN,
  AuthConfig,
  authConfigDefault,
  AuthService,
} from './auth';

@NgModule()
export class AuthModule {
  constructor(@Optional() @SkipSelf() parentModule?: AuthModule) {
    if (parentModule) {
      throw new Error(
        'AuthModule is already loaded. Import it in the AppModule only'
      );
    }
  }

  static forRoot(
    config: Partial<AuthConfig> = {}
  ): ModuleWithProviders<AuthModule> {
    return {
      ngModule: AuthModule,
      providers: [
        AuthService,
        {
          provide: AUTH_CONFIG_TOKEN,
          useValue: {
            ...authConfigDefault,
            ...config,
          },
        },
      ],
    };
  }
}
```

