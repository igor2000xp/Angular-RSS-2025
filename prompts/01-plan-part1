## 3. Data Models & Interfaces

```typescript
// Tab interface
interface Tab {
  id: string;
  title: string;
  cards: Card[];
}

// Card interface
interface Card {
  id: string;
  title: string;
  layout: 'singleDevice' | 'horizontalLayout' | 'verticalLayout';
  items: (Device | Sensor)[];
}

// Base item interface
interface BaseItem {
  type: 'device' | 'sensor';
  icon: string;
  label: string;
}

// Device interface
interface Device extends BaseItem {
  type: 'device';
  state: boolean;
}

// Sensor interface
interface Sensor extends BaseItem {
  type: 'sensor';
  value: {
    amount: number;
    unit: string;
  };
}

// Dashboard data
interface DashboardData {
  tabs: Tab[];
}
```

